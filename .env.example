# ============================================================
# ALPHA SCHOOL ENTERPRISE CMS FRAMEWORK - ENVIRONMENT CONFIG
# ============================================================

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_cms
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=school_cms
DB_PORT=5432

# Redis Cache Layer (Redis 7)
REDIS_URL=redis://localhost:6379

# Applications Ports
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# AI & OpenAI / Gemini API Keys (Optional for production RAG vectors)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Security & Session
JWT_SECRET=super-secret-jwt-key-change-in-production-2025
COOKIE_SECRET=super-secret-cookie-key-alpha-school-2025
