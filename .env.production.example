# ==============================================================================
# Enterprise Environment Configuration Template (Production)
# Alpha School Website Management Framework / Modular CMS
# ==============================================================================

# --- 1. CORE RUNTIME ENVIRONMENT ---
NODE_ENV=production
PORT=4000
TZ=Asia/Ho_Chi_Minh

# --- 2. HIGH-AVAILABILITY DATABASE (PostgreSQL 16) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_HIGH_ENTROPY_DATABASE_PASSWORD_MIN_32_CHARS
DB_NAME=school_cms_prod
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=prefer

# --- 3. IN-MEMORY CACHE & SESSION STORE (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_MIN_32_CHARS
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# --- 4. CRYPTOGRAPHIC SECRETS & KEY RINGS (Minimum 64 characters) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_JWT_SECRET_KEY_MIN_64_CHARACTERS
HMAC_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_HMAC_SHA256_SECRET_KEY_MIN_64_CHARACTERS
PREVIEW_TOKEN_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_PREVIEW_SECRET_KEY_MIN_64_CHARACTERS

# --- 5. APPLICATION DOMAINS & CORS POLICIES ---
SITE_URL=https://school.edu.vn
ADMIN_SITE_URL=https://admin.school.edu.vn
NEXT_PUBLIC_API_URL=https://school.edu.vn/api
CORS_ORIGIN=https://school.edu.vn,https://admin.school.edu.vn,https://*.school.edu.vn

# --- 6. S3-COMPATIBLE OBJECT STORAGE (Cloudflare R2 / AWS S3) ---
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=school-cms-media-prod
S3_ACCESS_KEY_ID=YOUR_R2_OR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_OR_S3_SECRET_ACCESS_KEY
CDN_PUBLIC_URL=https://media.school.edu.vn

# --- 7. ONLINE PAYMENT GATEWAYS (VietQR / VNPay / MoMo) ---
VIETQR_CLIENT_ID=YOUR_VIETQR_CLIENT_ID
VIETQR_API_KEY=YOUR_VIETQR_API_KEY
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET_MIN_32_CHARS
MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY_MIN_32_CHARS

# --- 8. AI ASSISTANT & RAG ENGINE ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_OR_VERTEX_AI_TOKEN
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_OPTIONAL

# --- 9. AUTOMATED BACKUP & RETENTION ---
BACKUP_DIR=/backups
RETENTION_DAYS=14
