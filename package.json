{
  "name": "school-cms-framework-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "School Website Management Framework / Modular CMS / Page Builder",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
